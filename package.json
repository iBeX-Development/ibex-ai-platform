{
  "name": "ibex-ai-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/api/src/index.js",
    "dev": "tsx apps/api/src/index.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:security": "vitest run tests/security tests/tenant",
    "test:phase10": "vitest run tests/evaluation tests/phase8 tests/security tests/tenant",
    "validate:phase10:engineering": "tsx scripts/phase10-validate-engineering.ts",
    "evaluate:phase10:release": "tsx scripts/phase10-evaluate.ts",
    "evaluate:phase10": "tsx scripts/phase10-evaluate.ts",
    "evaluate:phase10:update": "tsx scripts/phase10-evaluate.ts --write-evidence",
    "scan:dependency": "corepack pnpm audit --audit-level high",
    "scan:secret": "node scripts/phase10-scan.mjs secret",
    "scan:direct-core-db": "node scripts/phase10-scan.mjs direct-core-db",
    "scan:provider-coupling": "node scripts/phase10-scan.mjs provider-coupling",
    "scan:evaluation-leakage": "node scripts/phase10-scan.mjs evaluation-leakage",
    "scan:phase11-scope": "node scripts/phase10-scan.mjs phase11-scope",
    "scan:phase10": "node scripts/phase10-scan.mjs secret && node scripts/phase10-scan.mjs direct-core-db && node scripts/phase10-scan.mjs provider-coupling && node scripts/phase10-scan.mjs evaluation-leakage && node scripts/phase10-scan.mjs phase11-scope",
    "validate": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build && corepack pnpm scan:phase10 && corepack pnpm validate:phase10:engineering"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "pino": "^9.9.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^4.1.11"
  }
}
