# Copy to .env for local use. Never place real production credentials here.
IBEX_CONFIG_VERSION=1
IBEX_ENVIRONMENT=local
IBEX_SERVICE_NAME=ai-runtime
IBEX_HOST=0.0.0.0
IBEX_PORT=3000
IBEX_LOG_LEVEL=info
IBEX_SECRET_SOURCE=environment
IBEX_REQUEST_TIMEOUT_MS=30000
IBEX_MAX_RETRIES=2
IBEX_RATE_LIMIT_PER_MINUTE=60
IBEX_GATEWAY_MAX_PAYLOAD_BYTES=1048576
# Optional Phase 1+ service boundaries; leave unset in Phase 0.
# IBEX_AI_GATEWAY_BASE_URL=https://gateway.example.invalid
# IBEX_MODEL_GATEWAY_BASE_URL=https://model-gateway.example.invalid
# IBEX_RAG_SERVICE_BASE_URL=https://rag.example.invalid
# IBEX_TOOL_SERVICE_BASE_URL=https://tools.example.invalid
# IBEX_AUDIT_ENDPOINT=https://audit.example.invalid
# IBEX_OTEL_EXPORTER_ENDPOINT=https://otel.example.invalid
IBEX_FEATURE_AGENTS_ENABLED=false
IBEX_FEATURE_RAG_ENABLED=false
IBEX_FEATURE_TOOLS_ENABLED=false
IBEX_FEATURE_MODEL_GATEWAY_ENABLED=false
